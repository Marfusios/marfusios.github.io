{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marfusios",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
